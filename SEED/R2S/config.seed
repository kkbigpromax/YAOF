# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_frps is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
CONFIG_PACKAGE_luci-app-opkg=y
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-app-wechatpush is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-unblockneteasemusic is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set
# CONFIG_PACKAGE_luci-app-usb-printer is not set
# CONFIG_PACKAGE_luci-app-services-wolplus is not set
# CONFIG_PACKAGE_luci-app-xlnetacc is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set
# CONFIG_PACKAGE_luci-app-watchcat is not set
# CONFIG_PACKAGE_luci-app-natmapt is not set
# CONFIG_PACKAGE_stuntman-client is not set
# CONFIG_PACKAGE_luci-app-oaf is not set
# CONFIG_PACKAGE_zerotier is not set
# CONFIG_PACKAGE_coremark is not set
CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_subconverter=y
# CONFIG_PACKAGE_natflow-boot=y
# CONFIG_PACKAGE_luci-app-nikki is not set
# CONFIG_PACKAGE_luci-app-filemanager is not set
# CONFIG_PACKAGE_luci-app-einat is not set
# Keep the upstream replacement and its BTF dependency out of this Xray-only build.
# CONFIG_PACKAGE_luci-app-flowcone is not set
# CONFIG_PACKAGE_flowcone is not set
# CONFIG_PACKAGE_luci-app-bandix is not set

### SSRP ###
# CONFIG_PACKAGE_luci-app-ssr-plus is not set

### PASSWALL2 (Xray only) ###
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn is not set
# Old Passwall-only helpers are not needed by the Passwall2 Xray path.
# CONFIG_PACKAGE_dns2socks is not set
# CONFIG_PACKAGE_microsocks is not set
# CONFIG_PACKAGE_ipt2socks is not set
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# Omit optional alternate clients, servers, plugins and load balancing.
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_haproxy is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-local is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir is not set
# CONFIG_PACKAGE_shadowsocksr-libev-ssr-server is not set
# CONFIG_PACKAGE_simple-obfs-client is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_xray-plugin is not set
# CONFIG_PACKAGE_hysteria is not set
# CONFIG_PACKAGE_naiveproxy is not set
# CONFIG_PACKAGE_shadow-tls is not set

### THEME ###
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

### RESET ###
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y

### SHARE NETWORK ###
# CONFIG_PACKAGE_usbmuxd is not set
# CONFIG_PACKAGE_kmod-usb-net-rndis is not set
# CONFIG_PACKAGE_kmod-usb-net-ipheth is not set

### BBRv3 ###
CONFIG_PACKAGE_kmod-tcp-bbr=y

### OPENSSL ###
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y
# CONFIG_OPENSSL_WITH_ERROR_MESSAGES is not set
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-devcrypto=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_libcurl=y
CONFIG_LIBCURL_OPENSSL=y
# CONFIG_LIBCURL_MBEDTLS is not set
# CONFIG_LIBCURL_WOLFSSL is not set
# CONFIG_LIBCURL_GNUTLS is not set
# CONFIG_LIBCURL_NOSSL is not set

